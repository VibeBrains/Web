# Куда выкатывается сайт. Скопируйте в .env и заполните под свой сервер —
# .env в .gitignore, поэтому реальные значения не попадут в репозиторий.
#
#   cp .env.example .env

# Алиас хоста в ~/.ssh/config, который создаёт scripts/setup-ssh.sh
HOST_ALIAS=vibeide

# Пользователь и хост для SSH
REMOTE_USER=deploy
REMOTE_HOST=example.com

# Каталог документа на сервере (должен принадлежать REMOTE_USER — тогда rsync не требует sudo)
REMOTE_DIR=/var/www/example.com

# Публичный адрес сайта — по нему deploy.sh проверяет, что выкат доехал
SITE_URL=https://example.com/
