---
import '../styles/global.css'
import { BASE_LANG, languages, langPaths, langTags, type Lang } from '../config/languages'
import { LANG_STORAGE_KEY } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
const site = Astro.site ?? new URL(Astro.url.origin)
const canonical = new URL(langPaths[lang], site).href
const isBase = lang === BASE_LANG
---

<!doctype html>
<html lang={langTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical} />
    {languages.map((code) => <link rel="alternate" hreflang={langTags[code]} href={new URL(langPaths[code], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(langPaths[BASE_LANG], site).href} />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={langTags[lang]} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Runs before the first paint:
      marks that scripts work (reveal-on-scroll hides content only then)
      and, on the base-language page only, honours a language the visitor picked explicitly earlier
      The browser language is never consulted: Russian stays the default
    -->
    <script is:inline define:vars={{ storageKey: LANG_STORAGE_KEY, isBase, paths: langPaths }}>
      document.documentElement.classList.add('js')
      if (isBase) {
        try {
          const picked = localStorage.getItem(storageKey)
          if (picked && picked in paths && paths[picked] !== location.pathname) {
            location.replace(paths[picked] + location.hash)
          }
        } catch {
          // Storage can be blocked: the base language is the right answer then
        }
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <slot />
    <script>
      import '../scripts/main'
    </script>
  </body>
</html>
