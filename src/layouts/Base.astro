---
import KitBase from '@vibebrains/site-kit/components/Base.astro'
import '../styles/theme.css'
import type { Lang } from '@vibebrains/site-kit/languages'
import { LANG_STORAGE_KEY } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<KitBase
  lang={lang}
  title={t('meta.title')}
  description={t('meta.description')}
  skip={t('a11y.skip')}
  storageKey={LANG_STORAGE_KEY}
  themeColor="#09090b"
  ogImage="/og.png"
>
  <slot />
  <script>
    import '../scripts/main'
  </script>
</KitBase>
