---
import KitHeader from '@vibebrains/site-kit/components/Header.astro'
import Mark from './Mark.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { links } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<KitHeader
  lang={lang}
  brand={t('brand')}
  homeLabel={t('header.home')}
  navLabel={t('header.nav')}
  nav={[
    { href: '#why', label: t('header.why') },
    { href: '#features', label: t('header.features') },
    { href: '#install', label: t('header.install') },
  ]}
  langLabel={t('lang.label')}
  langNames={{
    ru: { code: t('lang.ru.code'), name: t('lang.ru.name') },
    en: { code: t('lang.en.code'), name: t('lang.en.name') },
  }}
  actions={[
    { kind: 'ghost', href: links.github, rel: 'noopener', label: t('header.github') },
    { kind: 'primary', href: '#download', label: t('header.download') },
  ]}
>
  <Mark slot="logo" size={30} animated />
</KitHeader>
