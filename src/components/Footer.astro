---
import KitFooter from '@vibebrains/site-kit/components/Footer.astro'
import Mark from './Mark.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { links } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<KitFooter
  lang={lang}
  brand={t('brand')}
  homeLabel={t('header.home')}
  tagline={t('footer.tagline')}
  navLabel={t('footer.nav')}
  links={[
    { href: links.github, rel: 'noopener', label: t('footer.repo') },
    { href: links.releases, rel: 'noopener', label: t('footer.releases') },
    { href: links.issues, rel: 'noopener', label: t('footer.issues') },
    { href: links.functional, rel: 'noopener', label: t('footer.functional') },
  ]}
  copyright={t('footer.copyright', { year: new Date().getFullYear() })}
  langLabel={t('lang.label')}
  langNames={{
    ru: { code: t('lang.ru.code'), name: t('lang.ru.name') },
    en: { code: t('lang.en.code'), name: t('lang.en.name') },
  }}
>
  <Mark slot="logo" size={28} />
</KitFooter>
