---
import Lines from './Lines.astro'
import type { Lang } from '../config/languages'
import { brandIcons, links, siblings } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<section class="section family">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow" data-reveal>{t('family.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-i: 1"><Lines text={t('family.title')} /></h2>
      <p class="section-lead" data-reveal style="--reveal-i: 2"><Lines text={t('family.lead')} /></p>
    </div>

    <div class="products">
      <div class="product product--here" data-reveal style="--reveal-i: 0">
        <div class="product-inner" data-tilt-card>
          <span class="badge">{t('family.here')}</span>
          <span class="product-mark" aria-hidden="true">
            <img src={brandIcons.vibeide} alt="" width="56" height="56" />
          </span>
          <h3>{t('brand')}</h3>
          <p>{t('family.vibeide')}</p>
        </div>
      </div>

      <a class="product" href={links.vibeidea} rel="noopener" data-reveal style="--reveal-i: 1">
        <span class="product-inner" data-tilt-card>
          <span class="product-mark" aria-hidden="true">
            <img src={brandIcons.vibeidea} alt="" width="56" height="56" />
          </span>
          <span class="product-name">{siblings.vibeidea}</span>
          <span class="product-text">{t('family.vibeidea')}</span>
          <span class="product-open">{t('family.open')}</span>
        </span>
      </a>

      <a class="product" href={links.vibememory} rel="noopener" data-reveal style="--reveal-i: 2">
        <span class="product-inner" data-tilt-card>
          <span class="product-mark" aria-hidden="true">
            <img src={brandIcons.vibememory} alt="" width="56" height="56" />
          </span>
          <span class="product-name">{siblings.vibememory}</span>
          <span class="product-text">{t('family.vibememory')}</span>
          <span class="product-open">{t('family.open')}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .products {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 860px) {
    .products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .product {
    perspective: 900px;
    color: inherit;
  }

  .product:hover {
    color: inherit;
  }

  .product-inner {
    --tx: 0deg;
    --ty: 0deg;
    position: relative;
    display: grid;
    gap: 10px;
    height: 100%;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    transform: rotateX(var(--tx)) rotateY(var(--ty));
    transform-style: preserve-3d;
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s;
  }

  .product--here .product-inner {
    border-color: rgb(63 199 194 / 0.4);
    background:
      linear-gradient(180deg, rgb(63 199 194 / 0.08), rgb(177 60 192 / 0.06)),
      linear-gradient(180deg, var(--surface-2), var(--surface));
  }

  a.product:hover .product-inner {
    border-color: var(--border-strong);
  }

  .product-mark {
    display: block;
    transform: translateZ(40px);
    filter: drop-shadow(0 12px 22px rgb(0 0 0 / 0.5));
  }

  h3,
  .product-name {
    color: var(--fg);
    font-family: var(--font-accent);
    font-size: 20px;
    font-weight: 700;
    transform: translateZ(24px);
  }

  .product-inner p,
  .product-text {
    color: var(--fg-muted);
    font-size: 15px;
    transform: translateZ(12px);
  }

  .product-open {
    margin-top: 4px;
    color: var(--brand-bright);
    font-size: 15px;
    font-weight: 600;
  }

  .product-open::after {
    content: ' →';
  }

  .badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-bright);
    font-family: var(--font-accent);
    font-size: 12px;
  }
</style>
