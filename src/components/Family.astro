---
import KitFamily from '@vibebrains/site-kit/components/Family.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { links } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<KitFamily
  here="vibeide"
  eyebrow={t('family.eyebrow')}
  title={t('family.title')}
  lead={t('family.lead')}
  hereLabel={t('family.here')}
  openLabel={t('family.open')}
  texts={{ vibeide: t('family.vibeide'), vibeidea: t('family.vibeidea'), vibememory: t('family.vibememory') }}
  links={{ vibeide: links.github, vibeidea: links.vibeidea, vibememory: links.vibememory }}
/>
