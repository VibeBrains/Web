---
import Lines from './Lines.astro'
import Copy from './Copy.astro'
import { langTags, type Lang } from '../config/languages'
import { links, WINGET_COMMAND } from '../config/site'
import { buildReleases } from '../config/build'
import { kindOf, toMb, type AssetKind } from '../config/releases'
import { useTranslations, type Key } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)

const RELEASES_SHOWN = 3

const steps: readonly { title: Key; text: Key }[] = [
  { title: 'install.s1.title', text: 'install.s1.text' },
  { title: 'install.s2.title', text: 'install.s2.text' },
  { title: 'install.s3.title', text: 'install.s3.text' },
]

const kindKeys: Record<AssetKind, Key> = {
  winSetup: 'releases.winSetup',
  winZip: 'releases.winZip',
  dmg: 'releases.dmg',
  macZip: 'releases.macZip',
}

const dateOf = (iso: string) =>
  new Intl.DateTimeFormat(langTags[lang], { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso))

const shown = buildReleases.slice(0, RELEASES_SHOWN).map((release) => ({
  title: t('releases.item', { version: release.tag_name, date: dateOf(release.published_at) }),
  assets: release.assets.flatMap((asset) => {
    const kind = kindOf(asset.name)
    return kind === undefined
      ? []
      : [{ href: asset.browser_download_url, label: t(kindKeys[kind]), size: t('releases.size', { size: toMb(asset.size) }) }]
  }),
}))

const macSteps: readonly Key[] = ['firstRun.macos.s1', 'firstRun.macos.s2', 'firstRun.macos.s3']
---

<section class="section install" id="install">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow" data-reveal>{t('install.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-i: 1">{t('install.title')}</h2>
    </div>

    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-i: ${i}`}>
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3>{t(step.title)}</h3>
            <p>
              <Lines text={t(step.text)} />
            </p>
          </li>
        ))
      }
    </ol>

    <div class="panels">
      <div
        class="panel releases"
        data-reveal
        data-releases
        data-item-template={t('releases.item')}
        data-size-template={t('releases.size')}
        data-kind-win-setup={t('releases.winSetup')}
        data-kind-win-zip={t('releases.winZip')}
        data-kind-dmg={t('releases.dmg')}
        data-kind-mac-zip={t('releases.macZip')}
      >
        <h3>{t('releases.title')}</h3>
        <ul class="release-list" data-releases-list>
          {
            shown.map((release) => (
              <li>
                <span class="release-title">{release.title}</span>
                <span class="release-assets">
                  {release.assets.map((asset) => (
                    <a href={asset.href} rel="noopener">
                      <span>{asset.label}</span>
                      <span class="size">{asset.size}</span>
                    </a>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="all" href={links.releases} rel="noopener">{t('releases.all')}</a>
      </div>

      <div class="panel first-run" data-reveal style="--reveal-i: 1">
        <h3>{t('firstRun.title')}</h3>
        <p class="first-run-lead"><Lines text={t('firstRun.lead')} /></p>
        <div class="os-cols">
          <div class="os">
            <h4>{t('firstRun.windows')}</h4>
            <ol>
              <li>{t('firstRun.windows.s1')}</li>
              <li>{t('firstRun.windows.s2')}</li>
            </ol>
            <p class="os-note">{t('firstRun.windows.note')}</p>
            <Copy lang={lang} command={WINGET_COMMAND} />
          </div>
          <div class="os">
            <h4>{t('firstRun.macos')}</h4>
            <ol>
              {
                macSteps.map((step) => (
                  <li>
                    <Lines text={t(step)} />
                  </li>
                ))
              }
            </ol>
            <p class="os-note">{t('firstRun.macos.note')}</p>
          </div>
        </div>
        <a class="more" href={links.firstRun} rel="noopener">{t('firstRun.more')}</a>
      </div>
    </div>

    <div class="honesty" data-reveal>
      <h3>{t('honesty.title')}</h3>
      <p><Lines text={t('honesty.text')} /></p>
      <a href={links.issues} rel="noopener">{t('honesty.link')}</a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
    counter-reset: step;
  }

  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-deep);
    color: #fff;
    font-family: var(--font-accent);
    font-weight: 700;
    box-shadow: 0 0 24px -4px var(--brand-glow);
  }

  .step h3 {
    font-size: 20px;
  }

  .step p {
    display: grid;
    gap: 4px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .panels {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 1000px) {
    .panels {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .panel {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    min-width: 0;
  }

  .panel h3 {
    font-size: 20px;
  }

  /* The list is refreshed from GitHub by a script: its nodes carry no scope attribute, so these rules are global */
  .release-list {
    display: grid;
    gap: 14px;
  }

  .release-list :global(li) {
    display: grid;
    gap: 8px;
  }

  .release-list :global(.release-title) {
    color: var(--fg);
    font-family: var(--font-accent);
    font-size: 14px;
    font-weight: 600;
  }

  .release-list :global(.release-assets) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .release-list :global(.release-assets a) {
    display: inline-flex;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--fg-soft);
    font-size: 13px;
  }

  .release-list :global(.release-assets a:hover) {
    border-color: rgb(63 199 194 / 0.5);
    color: var(--fg);
  }

  .release-list :global(.size) {
    color: var(--fg-faint);
    font-family: var(--font-accent);
  }

  .all,
  .more {
    font-size: 15px;
    font-weight: 500;
  }

  .first-run-lead {
    display: grid;
    gap: 4px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .os-cols {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .os-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* One track no wider than the column: the copyable command scrolls inside it instead of widening the column */
  .os {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 10px;
    min-width: 0;
  }

  .os h4 {
    margin: 0;
    color: var(--fg);
    font-size: 16px;
  }

  .os ol {
    display: grid;
    gap: 8px;
    padding-left: 20px;
    list-style: decimal;
    color: var(--fg-soft);
    font-size: 14px;
  }

  .os-note {
    color: var(--fg-faint);
    font-size: 13px;
  }

  .honesty {
    display: grid;
    gap: 8px;
    margin-top: 16px;
    padding: 20px 24px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .honesty h3 {
    font-size: 18px;
  }

  .honesty p {
    display: grid;
    gap: 4px;
    color: var(--fg-muted);
    font-size: 15px;
  }
</style>
