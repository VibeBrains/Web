---
import KitDownloadButtons from '@vibebrains/site-kit/components/DownloadButtons.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { newestBuild } from '@vibebrains/site-kit/releases'
import { links } from '../config/site'
import { buildReleases } from '../config/build'
import { KINDS, type Os } from '../config/releases'
import { useTranslations, type Key } from '../i18n'

/** The two download buttons, filled with the newest build of each platform as of the build */
interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)

const buttons: readonly { os: Os; title: Key; sub: Key; primary: boolean }[] = [
  { os: 'windows', title: 'download.windows', sub: 'download.windows.sub', primary: true },
  { os: 'macos', title: 'download.macos', sub: 'download.macos.sub', primary: false },
]

const view = buttons.map((button) => {
  const build = newestBuild(buildReleases, button.os, KINDS)
  return {
    os: button.os,
    primary: button.primary,
    title: t(button.title),
    href: build?.url ?? links.releases,
    sub: build ? t(button.sub, { version: build.version, size: build.sizeMb }) : t('download.fallback'),
    template: t(button.sub),
  }
})
---

<KitDownloadButtons buttons={view} />
